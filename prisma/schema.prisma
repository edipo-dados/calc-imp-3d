generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              Int      @id @default(autoincrement())
  nome            String
  email           String   @unique
  senha           String
  role            String   @default("pendente")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Filamento {
  id              Int      @id @default(autoincrement())
  nome            String
  tipo            String   @default("PLA")
  cor             String   @default("Padrão")
  precoPorKg      Float
  densidade       Float?
  estoqueKg       Float    @default(0)
  estoqueMinKg    Float    @default(0.2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Impressora {
  id                  Int      @id @default(autoincrement())
  nome                String
  marca               String   @default("")
  modelo              String   @default("")
  potenciaWatts       Float
  valorCompra         Float
  vidaUtilHoras       Float
  horasUsadas         Float    @default(0)
  manutencaoPorHora   Float    @default(0)
  taxaFalhaPercentual Float    @default(5)
  volumeMaxX          Float?
  volumeMaxY          Float?
  volumeMaxZ          Float?
  ativa               Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Orcamento {
  id              Int      @id @default(autoincrement())
  nomePeca        String
  inputs          Json
  breakdown       Json
  precoIdeal      Float
  precoMinimo     Float
  precoPremium    Float
  createdAt       DateTime @default(now())
}
